# Azure owns the DNS name; no custom-domain setup is required (ADR platform/0016).
{$SITE_ADDRESS:localhost} {
	encode zstd gzip
	redir /welcome /welcome/ permanent
	# Strip the public prefix before the marketing file server resolves its assets.
	handle_path /welcome/* {
		reverse_proxy marketing:80
	}
	handle {
		reverse_proxy app:80
	}
}
