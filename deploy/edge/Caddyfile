# The Azure DNS name serves the application at / and the marketing site at /welcome/ (ADR platform/0016).
{$SITE_ADDRESS:localhost} {
	encode zstd gzip
	redir /welcome /welcome/ permanent
	# Strip the public prefix before the marketing file server resolves its assets.
	handle_path /welcome/* {
		reverse_proxy marketing:80
	}
	handle {
		reverse_proxy app:80
	}
}

# The registered domain shows the marketing site (ADR platform/0017). Namecheap points the apex A record at the
# VM's static IP and www at the apex; Caddy issues both certificates. Any other path belongs to the application
# on the Azure DNS name, where the marketing page's links already go.
www.sycapooke.com {
	redir https://sycapooke.com{uri} permanent
}

sycapooke.com {
	encode zstd gzip
	redir / /welcome/
	redir /welcome /welcome/ permanent
	handle_path /welcome/* {
		reverse_proxy marketing:80
	}
	handle {
		redir https://{$SITE_ADDRESS:localhost}{uri}
	}
}
