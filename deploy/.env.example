# Copy to /opt/sycapooke/.env on the server. Never commit the real file.
IMAGE_PREFIX=ghcr.io/quinntynebrown
# Image tags, each moved only by its own workflow: deploy-marketing.yml sets MARKETING_TAG, deploy-app.yml sets APP_TAG.
MARKETING_TAG=latest
APP_TAG=latest
# Azure DNS name. Both deploy workflows rewrite this line from SITE_HOST.
SITE_ADDRESS=sycapooke.canadacentral.cloudapp.azure.com

ConnectionStrings__Sycapooke=Server=tcp:<server>.database.windows.net,1433;Database=Sycapooke;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30
Auth__SigningKey=<64 random characters>
Notifications__UnsubscribeSigningKey=<64 random characters>
App__BaseUrl=https://app.sycapooke.com

# The one founder's member ID (a single GUID). Empty grants nobody shop access; see docs/deployment.md, Provision the founder.
Shop__FounderMemberId=

# Field encryption keys for shipping addresses (L2-054): id:base64 pairs, comma separated, the first is current.
# Make a key with: openssl rand -base64 32. Keep old keys in the list after rotating so older rows still read.
Privacy__FieldEncryptionKeys=k1:<base64 of 32 random bytes>

# Sign in with Google (L2-088, ADR accounts/0001). Leave both empty to keep the feature off; set both to turn it on.
# The OAuth client's authorised redirect URI is https://sycapooke.canadacentral.cloudapp.azure.com/api/auth/google/callback (see docs/deployment.md).
Auth__Google__ClientId=
Auth__Google__ClientSecret=
