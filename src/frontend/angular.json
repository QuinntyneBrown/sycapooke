{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "sycapooke": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/sycapooke",
      "sourceRoot": "projects/sycapooke/src",
      "prefix": "sy",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/sycapooke/src/main.ts",
            "tsConfig": "projects/sycapooke/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/sycapooke/public"
              }
            ],
            "styles": [
              "projects/components/src/styles/tokens.css",
              "projects/components/src/styles/components.css",
              "projects/sycapooke/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "550kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/sycapooke/src/environments/environment.ts",
                  "with": "projects/sycapooke/src/environments/environment.development.ts"
                }
              ]
            },
            "marketing": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "index": {
                "input": "projects/sycapooke/src/index.marketing.html",
                "output": "index.html"
              },
              "fileReplacements": [
                {
                  "replace": "projects/sycapooke/src/app/app.routes.ts",
                  "with": "projects/sycapooke/src/app/app.routes.marketing.ts"
                },
                {
                  "replace": "projects/sycapooke/src/environments/environment.ts",
                  "with": "projects/sycapooke/src/environments/environment.marketing.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "sycapooke:build:production"
            },
            "development": {
              "buildTarget": "sycapooke:build:development"
            },
            "marketing": {
              "buildTarget": "sycapooke:build:marketing"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "projects/sycapooke/proxy.conf.json"
          }
        }
      }
    },
    "api": {
      "projectType": "library",
      "root": "projects/api",
      "sourceRoot": "projects/api/src",
      "prefix": "sy",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/api/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/api/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "components": {
      "projectType": "library",
      "root": "projects/components",
      "sourceRoot": "projects/components/src",
      "prefix": "sy",
      "architect": {
        "build": {
