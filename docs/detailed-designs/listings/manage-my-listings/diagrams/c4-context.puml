@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Manage my listings

Person(seller, "Seller", "Reviews all of their own listings")
System(sycapooke, "Sycapooke", "Marketplace for vintage jewelry, clothing, housewares and electronics")
System_Ext(email, "Email provider", "Delivers draft expiry reminders")

