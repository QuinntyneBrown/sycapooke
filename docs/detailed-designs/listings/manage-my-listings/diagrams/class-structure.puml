@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Class structure - Manage founder inventory
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class "ListingsController" as Entry {
}
class "GetMyListingsQueryHandler" as Handler {
 +Handle(request: GetMyListingsQuery, cancellationToken: CancellationToken): Task<Result<MyListingsDto>>
}
class "Listing" as Model {
 +Guid SellerId
 +ListingStatus Status
 +DateTime CreatedAt
}
class "GetMyListingsQuery" as Request {
 +Guid SellerId
 +string? Status
}
Handler ..> Request : handles
Entry ..> Handler : dispatches
Handler --> Model : reads or changes
interface ISycapookeDbContext {
 +SaveChangesAsync(): Task<int>
}
Handler ..> ISycapookeDbContext : persistence boundary
interface IFounderAccess {
 +IsFounderAsync(memberId: Guid): Task<bool>
}
Handler ..> IFounderAccess : protected shop actions
note bottom of Handler
Operation names summarize target responsibilities.
Description distinguishes existing and proposed types.
end note
