@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Behaviour - Choose a listing photograph
autonumber
actor "Founder" as actor
box "Frontend - Sycapooke Web" #E0F2FE
 participant "SellPage" as page
 participant "PhotosApi" as client
end box
box "Backend - Sycapooke API" #D1FADF
 participant "PhotoUploadsController" as entry
end box
box "Backend - Sycapooke Application and Domain" #ECFDF3
 participant "ListingPhotoHandlers" as handler
 participant "ListingPhoto" as model
end box
box "Backend - Sycapooke Infrastructure" #FFF4E5
 database "Feature state / unit of work" as db
end box
actor -> page : Choose a listing photograph
page -> client : Existing listing-photo upload endpoint
client -> entry : Typed HTTPS request
entry -> handler : Authenticate session or signed callback
handler -> db : Load authorized current state
db --> handler : Current state
alt Access, validation or state check refuses the action
 handler -> handler : Preserve state and return domain refusal
else Authorized and valid action
handler -> handler : Require founder and validate image content and limits [L2-017]
handler -> model : Strip metadata and produce resized WebP/JPEG versions
handler -> handler : Attach photo to founder inventory within eight-photo limit
handler -> db : Commit valid state and outbox atomically
db --> handler : Result
end
handler --> entry : Result or domain refusal
entry --> client : Typed result or ProblemDetails
client --> page : Update feature state
page --> actor : Processed variants and photo ID; 403 customer or image validation error
note over entry, handler
Processed variants and photo ID; 403 customer or image validation error
end note
@enduml
