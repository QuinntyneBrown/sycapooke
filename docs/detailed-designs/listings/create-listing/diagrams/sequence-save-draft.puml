@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Behaviour - Save a founder draft
autonumber
actor "Founder" as actor
box "Frontend - Sycapooke Web" #E0F2FE
 participant "SellPage" as page
 participant "ListingsApi" as client
end box
box "Backend - Sycapooke API" #D1FADF
 participant "ListingsController" as entry
end box
box "Backend - Sycapooke Application and Domain" #ECFDF3
 participant "ListingCommandHandlers" as handler
 participant "Listing" as model
end box
box "Backend - Sycapooke Infrastructure" #FFF4E5
 database "Feature state / unit of work" as db
end box
actor -> page : Save a founder draft
page -> client : POST /api/listings
client -> entry : Typed HTTPS request
entry -> handler : Authenticate session or signed callback
handler -> db : Load authorized current state
db --> handler : Current state
alt Access, validation or state check refuses the action
 handler -> handler : Preserve state and return domain refusal
else Authorized and valid action
handler -> handler : Enforce configured founder before validation [L2-003]
handler -> model : Set owner from trusted member ID
handler -> handler : Validate supplied fields and persist Draft [L2-019]
handler -> db : Commit valid state and outbox atomically
db --> handler : Result
end
handler --> entry : Result or domain refusal
entry --> client : Typed result or ProblemDetails
client --> page : Update feature state
page --> actor : Draft saved privately; customer gets 403
note over entry, handler
Draft saved privately; customer gets 403
end note
@enduml
