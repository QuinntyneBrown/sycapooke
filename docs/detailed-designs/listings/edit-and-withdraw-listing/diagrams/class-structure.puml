@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Class structure - Edit and withdraw founder inventory
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class "ListingsController" as Entry {
}
class "ListingCommandHandlers" as Handler {
 +Handle(request: UpdateListingCommand, cancellationToken: CancellationToken): Task<Result<MyListingDto>>
}
class "Listing" as Model {
 +ListingStatus Status
 +string? RemovalReason
}
class "UpdateListingCommand" as Request {
 +Guid SellerId
 +string Reference
 +string? Description
 +IReadOnlyList<Guid>? PhotoIds
 +int? ExpectedVersion
}
Handler ..> Request : handles
Entry ..> Handler : dispatches
Handler --> Model : reads or changes
interface ISycapookeDbContext {
 +SaveChangesAsync(): Task<int>
}
Handler ..> ISycapookeDbContext : persistence boundary
interface IFounderAccess {
 +IsFounderAsync(memberId: Guid): Task<bool>
}
Handler ..> IFounderAccess : protected shop actions
note bottom of Handler
Operation names summarize target responsibilities.
Description distinguishes existing and proposed types.
end note
@enduml
