@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Behaviour - Save founder-approved public details
autonumber
actor "Visitor or customer" as actor
box "Frontend - Sycapooke Web" #E0F2FE
 participant "MemberProfilePage" as page
 participant "MembersApi" as client
end box
box "Backend - Sycapooke API" #D1FADF
 participant "FounderStoryController" as entry
end box
box "Backend - Sycapooke Application and Domain" #ECFDF3
 participant "UpdateFounderStoryHandler" as handler
 participant "Member" as model
end box
box "Backend - Sycapooke Infrastructure" #FFF4E5
 database "Feature state / unit of work" as db
end box
actor -> page : Save founder-approved public details
page -> client : PUT /api/shop/story
client -> entry : Typed HTTPS request
entry -> handler : Authenticate session or signed callback
handler -> db : Load authorized current state
db --> handler : Current state
alt Access, validation or state check refuses the action
 handler -> handler : Preserve state and return domain refusal
else Authorized and valid action
handler -> handler : Require founder before loading account [L2-004]
handler -> model : Validate unique display name, 500-character story and city/region
handler -> handler : Persist public fields without changing founder identity
handler -> db : Commit valid state and outbox atomically
db --> handler : Result
end
handler --> entry : Result or domain refusal
entry --> client : Typed result or ProblemDetails
client --> page : Update feature state
page --> actor : Updated founder story; 422 invalid fields; 403 customer
note over entry, handler
Updated founder story; 422 invalid fields; 403 customer
end note
@enduml
