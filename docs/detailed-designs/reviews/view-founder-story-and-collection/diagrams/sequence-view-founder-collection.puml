@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Behaviour - Open founder story and collection
autonumber
actor "Visitor or customer" as actor
box "Frontend - Sycapooke Web" #E0F2FE
 participant "MemberProfilePage" as page
 participant "MembersApi" as client
end box
box "Backend - Sycapooke API" #D1FADF
 participant "MembersController" as entry
end box
box "Backend - Sycapooke Application and Domain" #ECFDF3
 participant "GetPublicProfileQueryHandler" as handler
 participant "PublicProfileDto" as model
end box
box "Backend - Sycapooke Infrastructure" #FFF4E5
 database "Feature state / unit of work" as db
end box
actor -> page : Open founder story and collection
page -> client : GET /api/members/{displayName}; GET listings
client -> entry : Typed HTTPS request
entry -> handler : Authenticate session or signed callback
handler -> db : Load authorized current state
db --> handler : Current state
alt Access, validation or state check refuses the action
 handler -> handler : Preserve state and return domain refusal
else Authorized and valid action
handler -> handler : Resolve display name only against configured founder [L2-041]
handler -> model : Project approved public fields and Completed count
handler -> handler : Page 24 Active founder listings and empty rating [L2-040]
handler -> db : Project authorized response without mutation
db --> handler : Result
end
handler --> entry : Result or domain refusal
entry --> client : Typed result or ProblemDetails
client --> page : Update feature state
page --> actor : 200 founder story; customer and unknown names share 404
note over entry, handler
200 founder story; customer and unknown names share 404
end note
@enduml
