@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Behaviour - Join through a verified Google identity
autonumber
actor "Customer or founder" as actor
box "Frontend - Sycapooke Web" #E0F2FE
 participant "GoogleJoinPage" as page
 participant "AccountsApi" as client
end box
box "Backend - Sycapooke API" #D1FADF
 participant "GoogleSignInController" as entry
end box
box "Backend - Sycapooke Application and Domain" #ECFDF3
 participant "FinishGoogleJoinCommandHandler" as handler
 participant "ExternalLogin" as model
end box
box "Backend - Sycapooke Infrastructure" #FFF4E5
 database "Feature state / unit of work" as db
end box
participant "Google identity provider" as provider
actor -> page : Join through a verified Google identity
page -> client : Google start, callback and finish endpoints
client -> entry : Typed HTTPS request
entry -> handler : Authenticate session or signed callback
handler -> db : Load authorized current state
db --> handler : Current state
alt Access, validation or state check refuses the action
 handler -> handler : Preserve state and return domain refusal
else Authorized and valid action
handler -> handler : Validate OpenID Connect response and stable subject [L2-088]
handler -> model : Require display name, age and terms within 10 minutes
handler -> handler : Create private customer and session; derive isFounder=false
handler -> db : Commit valid state and outbox atomically
db --> handler : Result
end
handler --> entry : Result or domain refusal
entry --> client : Typed result or ProblemDetails
client --> page : Update feature state
page --> actor : Customer created without selling rights or public profile
note over entry, handler
Customer created without selling rights or public profile
end note
@enduml
