@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Class structure - Sign in with Google
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class "GoogleSignInController" as Entry {
}
class "FinishGoogleJoinCommandHandler" as Handler {
 +Handle(request: FinishGoogleJoinCommand, cancellationToken: CancellationToken): Task<Result<SignedIn>>
}
class "ExternalLogin" as Model {
 +Guid MemberId
 +string Subject
}
class "FinishGoogleJoinCommand" as Request {
 +string? Token
 +string? DisplayName
 +bool AgeConfirmed
 +bool TermsAccepted
}
Handler ..> Request : handles
Entry ..> Handler : dispatches
Handler --> Model : reads or changes
interface ISycapookeDbContext {
 +SaveChangesAsync(): Task<int>
}
Handler ..> ISycapookeDbContext : persistence boundary
note bottom of Handler
Operation names summarize target responsibilities.
Description distinguishes existing and proposed types.
end note
@enduml
