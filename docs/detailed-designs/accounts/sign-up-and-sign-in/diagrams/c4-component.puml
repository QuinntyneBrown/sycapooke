@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Sign up and sign in
Container_Boundary(slice, "Sycapooke API and Application") {
  Component(entry, "AuthController", "Controller", "Feature entry point")
  Component(handler, "SignInCommandHandler", "Application handler", "Executes feature rules")
  Component(entity, "Session", "Domain or read model", "Feature state and invariants")
  ComponentDb(db, "Sycapooke database", "SQL Server", "Persistent feature state")
}
Rel(entry, handler, "Dispatches validated action")
Rel(handler, entity, "Reads or applies rules")
Rel(handler, db, "Queries or saves atomically", "EF Core")
@enduml
