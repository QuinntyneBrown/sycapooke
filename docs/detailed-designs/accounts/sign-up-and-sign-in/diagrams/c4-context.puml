@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Sign up and sign in

Person(visitor, "Visitor or member", "Joins, verifies their email and signs in")
System(sycapooke, "Sycapooke", "Marketplace for vintage jewelry, clothing, housewares and electronics")
System_Ext(email, "Email provider", "Delivers the verification link (logged until send-email-notifications)")

Rel(visitor, sycapooke, "Joins and signs in using", "HTTPS")
Rel(sycapooke, email, "Sends the verification email through")
Rel(email, visitor, "Delivers the link to")
@enduml
