@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Behaviour - Register and verify a private buyer account
autonumber
actor "Customer or founder" as actor
box "Frontend - Sycapooke Web" #E0F2FE
 participant "SignInPage" as page
 participant "AuthState" as client
end box
box "Backend - Sycapooke API" #D1FADF
 participant "AuthController" as entry
end box
box "Backend - Sycapooke Application and Domain" #ECFDF3
 participant "RegisterMemberCommandHandler / VerifyEmailCommandHandler" as handler
 participant "Member" as model
end box
box "Backend - Sycapooke Infrastructure" #FFF4E5
 database "Feature state / unit of work" as db
end box
actor -> page : Register and verify a private buyer account
page -> client : POST /api/auth/register; POST /api/auth/verify-email
client -> entry : Typed HTTPS request
entry -> handler : Authenticate session or signed callback
handler -> db : Load authorized current state
db --> handler : Current state
alt Access, validation or state check refuses the action
 handler -> handler : Preserve state and return domain refusal
else Authorized and valid action
handler -> handler : Validate name, email, password, age and terms [L2-001]
handler -> model : Store member and hashed 24-hour verification token
handler -> handler : Consume token once; preserve customer-only privileges [L2-002]
handler -> db : Commit valid state and outbox atomically
db --> handler : Result
end
handler --> entry : Result or domain refusal
entry --> client : Typed result or ProblemDetails
client --> page : Update feature state
page --> actor : 201 customer; verification 200 or expired/used error
note over entry, handler
201 customer; verification 200 or expired/used error
end note
@enduml
