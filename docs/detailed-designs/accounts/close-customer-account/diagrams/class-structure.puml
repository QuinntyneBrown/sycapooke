 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class "CustomerClosureController" as Entry {
}
class "CloseCustomerAccountHandler" as Handler {
 +Handle(request: CloseCustomerAccountCommand, cancellationToken: CancellationToken): Task<Result>
