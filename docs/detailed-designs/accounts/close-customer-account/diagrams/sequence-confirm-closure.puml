@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Behaviour - Confirm customer account closure
autonumber
actor "Customer" as actor
box "Frontend - Sycapooke Web" #E0F2FE
 participant "CloseAccountPage" as page
 participant "AccountsApi" as client
end box
box "Backend - Sycapooke API" #D1FADF
 participant "CustomerClosureController" as entry
end box
box "Backend - Sycapooke Application and Domain" #ECFDF3
 participant "CloseCustomerAccountHandler" as handler
 participant "Member" as model
end box
box "Backend - Sycapooke Infrastructure" #FFF4E5
 database "Feature state / unit of work" as db
end box
actor -> page : Confirm customer account closure
page -> client : POST /api/account/closure
client -> entry : Typed HTTPS request
entry -> handler : Authenticate session or signed callback
handler -> db : Load authorized current state
db --> handler : Current state
alt Access, validation or state check refuses the action
 handler -> handler : Preserve state and return domain refusal
else Authorized and valid action
handler -> handler : Validate password or fresh same-account Google proof [L2-005]
handler -> model : Reject founder and recheck open orders in transaction
handler -> handler : Close member and revoke sessions atomically [L2-008]
handler -> db : Commit valid state and outbox atomically
db --> handler : Result
end
handler --> entry : Result or domain refusal
entry --> client : Typed result or ProblemDetails
client --> page : Update feature state
page --> actor : 204 and cleared cookies; 403 founder; 409 open orders
note over entry, handler
204 and cleared cookies; 403 founder; 409 open orders
end note
@enduml
