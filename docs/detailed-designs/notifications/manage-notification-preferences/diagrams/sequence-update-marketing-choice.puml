@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Behaviour - Save marketing choice
autonumber
actor "Customer or founder" as actor
box "Frontend - Sycapooke Web" #E0F2FE
 participant "NotificationSettingsPage" as page
 participant "NotificationPreferencesApi" as client
end box
box "Backend - Sycapooke API" #D1FADF
 participant "NotificationPreferencesController" as entry
end box
box "Backend - Sycapooke Application and Domain" #ECFDF3
 participant "UpdateNotificationPreferencesCommandHandler" as handler
 participant "NotificationPreferences" as model
end box
box "Backend - Sycapooke Infrastructure" #FFF4E5
 database "Feature state / unit of work" as db
end box
participant "Email provider" as provider
actor -> page : Save marketing choice
page -> client : Existing notification preferences endpoint
client -> entry : Typed HTTPS request
entry -> handler : Authenticate session or signed callback
handler -> db : Load authorized current state
db --> handler : Current state
alt Access, validation or state check refuses the action
 handler -> handler : Preserve state and return domain refusal
else Authorized and valid action
handler -> handler : Derive account from session and preserve essential categories [L2-043]
handler -> model : Compare expected version
handler -> handler : Persist only marketing consent and new version
handler -> db : Commit valid state and outbox atomically
db --> handler : Result
end
handler --> entry : Result or domain refusal
entry --> client : Typed result or ProblemDetails
client --> page : Update feature state
page --> actor : Saved choice or 412 stale settings; review choice absent
note over entry, handler
Saved choice or 412 stale settings; review choice absent
end note
@enduml
