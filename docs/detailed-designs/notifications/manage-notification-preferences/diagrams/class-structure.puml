@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Class structure - Manage notification preferences
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class "NotificationPreferencesController" as Entry {
}
class "UpdateNotificationPreferencesCommandHandler" as Handler {
 +Handle(request: UpdateNotificationPreferencesCommand, cancellationToken: CancellationToken): Task<Result<NotificationPreferencesDto>>
}
class "NotificationPreferences" as Model {
 +Guid MemberId
 +bool MarketingEmails
 +int Version
}
class "UpdateNotificationPreferencesCommand" as Request {
 +Guid MemberId
 +bool? ReviewEmails
 +bool? MarketingEmails
 +int? ExpectedVersion
}
Handler ..> Request : handles
Entry ..> Handler : dispatches
Handler --> Model : reads or changes
interface ISycapookeDbContext {
 +SaveChangesAsync(): Task<int>
}
Handler ..> ISycapookeDbContext : persistence boundary
note bottom of Handler
Operation names summarize target responsibilities.
Description distinguishes existing and proposed types.
end note
@enduml
