@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Behaviour - Persist notification with state change
autonumber
actor "Customer or founder" as actor
box "Frontend - Sycapooke Web" #E0F2FE
 participant "OrderDetailPage" as page
 participant "OrdersApi" as client
end box
box "Backend - Sycapooke API" #D1FADF
 participant "OrdersController" as entry
end box
box "Backend - Sycapooke Application and Domain" #ECFDF3
 participant "EmailOutbox" as handler
 participant "OutboxMessage" as model
end box
box "Backend - Sycapooke Infrastructure" #FFF4E5
 database "Feature state / unit of work" as db
end box
participant "Email provider" as provider
actor -> page : Persist notification with state change
page -> client : Order or account command
client -> entry : Typed HTTPS request
entry -> handler : Authenticate session or signed callback
handler -> db : Load authorized current state
db --> handler : Current state
alt Access, validation or state check refuses the action
 handler -> handler : Preserve state and return domain refusal
else Authorized and valid action
handler -> handler : Select affected customer or configured founder [L2-042]
handler -> model : Persist typed outbox message in same transaction
handler -> handler : Avoid public customer details and administrator recipients
handler -> db : Commit valid state and outbox atomically
db --> handler : Result
end
handler --> entry : Result or domain refusal
entry --> client : Typed result or ProblemDetails
client --> page : Update feature state
page --> actor : Durable notification awaiting dispatch
note over entry, handler
Durable notification awaiting dispatch
end note
@enduml
