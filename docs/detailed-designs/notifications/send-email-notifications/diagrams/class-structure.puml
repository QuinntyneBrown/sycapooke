@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Class structure - Send account and shop order emails
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class "OrdersController" as Entry {
}
class "DispatchEmailsHandler" as Handler {
 +Handle(request: DispatchEmailsCommand, cancellationToken: CancellationToken): Task<Result>
}
class "OutboxMessage" as Model {
 +Guid Id
 +DateTime? SentAt
 +DateTime NextAttemptAt
}
class "DispatchEmailsCommand" as Request {
 +Guid MemberId
}
Handler ..> Request : handles
Entry ..> Handler : dispatches
Handler --> Model : reads or changes
interface ISycapookeDbContext {
 +SaveChangesAsync(): Task<int>
}
Handler ..> ISycapookeDbContext : persistence boundary
note bottom of Handler
Operation names summarize target responsibilities.
Description distinguishes existing and proposed types.
end note
@enduml
