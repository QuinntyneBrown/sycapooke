@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Behaviour - Decline pending cancellation request
autonumber
actor "Customer or founder" as actor
box "Frontend - Sycapooke Web" #E0F2FE
 participant "SaleDetailPage" as page
 participant "OrdersApi" as client
end box
box "Backend - Sycapooke API" #D1FADF
 participant "OrdersController" as entry
end box
box "Backend - Sycapooke Application and Domain" #ECFDF3
 participant "RespondToCancellationCommandHandler" as handler
 participant "Order" as model
end box
box "Backend - Sycapooke Infrastructure" #FFF4E5
 database "Feature state / unit of work" as db
end box
participant "Payment provider" as provider
actor -> page : Decline pending cancellation request
page -> client : POST /api/orders/{id}/cancellation-request/response
client -> entry : Typed HTTPS request
entry -> handler : Authenticate session or signed callback
handler -> db : Load authorized current state
db --> handler : Current state
alt Access, validation or state check refuses the action
 handler -> handler : Preserve state and return domain refusal
else Authorized and valid action
handler -> handler : Require founder and pending request [L2-010]
handler -> model : Persist decline without changing Paid order
handler -> handler : Show response to the requesting buyer
handler -> db : Commit valid state and outbox atomically
db --> handler : Result
end
handler --> entry : Result or domain refusal
entry --> client : Typed result or ProblemDetails
client --> page : Update feature state
page --> actor : Order remains Paid; customer cannot submit another request
note over entry, handler
Order remains Paid; customer cannot submit another request
end note
@enduml
