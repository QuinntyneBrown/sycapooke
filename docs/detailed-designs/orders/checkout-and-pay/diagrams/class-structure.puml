@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Class structure - Checkout and direct shop payment
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class "CheckoutsController" as Entry {
}
class "CheckoutCommandHandlers" as Handler {
 +Handle(request: StartCheckoutCommand, cancellationToken: CancellationToken): Task<Result<CheckoutDto>>
}
class "Checkout" as Model {
 +Guid BuyerId
 +Guid ListingId
 +DateTime ExpiresAt
 +decimal? Total
}
class "StartCheckoutCommand" as Request {
 +Guid BuyerId
 +string ListingReference
}
Handler ..> Request : handles
Entry ..> Handler : dispatches
Handler --> Model : reads or changes
interface ISycapookeDbContext {
 +SaveChangesAsync(): Task<int>
}
Handler ..> ISycapookeDbContext : persistence boundary
interface IFounderAccess {
 +IsFounderAsync(memberId: Guid): Task<bool>
}
Handler ..> IFounderAccess : protected shop actions
note bottom of Handler
Operation names summarize target responsibilities.
Description distinguishes existing and proposed types.
end note
@enduml
