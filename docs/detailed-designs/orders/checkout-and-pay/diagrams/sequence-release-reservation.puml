@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Behaviour - Release unpaid reservation
autonumber
actor "Verified customer" as actor
box "Frontend - Sycapooke Web" #E0F2FE
 participant "CheckoutPage" as page
 participant "CheckoutApi" as client
end box
box "Backend - Sycapooke API" #D1FADF
 participant "CheckoutsController" as entry
end box
box "Backend - Sycapooke Application and Domain" #ECFDF3
 participant "CheckoutCommandHandlers" as handler
 participant "Checkout" as model
end box
box "Backend - Sycapooke Infrastructure" #FFF4E5
 database "Feature state / unit of work" as db
end box
participant "Payment provider" as provider
actor -> page : Release unpaid reservation
page -> client : DELETE /api/checkouts/{id}; expiry job
client -> entry : Typed HTTPS request
entry -> handler : Authenticate session or signed callback
handler -> db : Load authorized current state
db --> handler : Current state
alt Access, validation or state check refuses the action
 handler -> handler : Preserve state and return domain refusal
else Authorized and valid action
handler -> handler : Check buyer or expiry-worker authority [L2-028]
handler -> model : Refuse release after payment
handler -> handler : Set unpaid listing Active and close reservation
handler -> db : Commit valid state and outbox atomically
db --> handler : Result
end
handler --> entry : Result or domain refusal
entry --> client : Typed result or ProblemDetails
client --> page : Update feature state
page --> actor : 204 release; paid checkout remains Sold
note over entry, handler
204 release; paid checkout remains Sold
end note
@enduml
