@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Class structure - Complete an order
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class "OrdersController" as Entry {
}
class "ConfirmReceiptCommandHandler" as Handler {
 +Handle(request: ConfirmReceiptCommand, cancellationToken: CancellationToken): Task<Result<PurchaseDto>>
}
class "Order" as Model {
 +OrderStatus Status
 +DateTime? DeliveredAt
 +DateTime? EndedAt
}
class "ConfirmReceiptCommand" as Request {
 +Guid BuyerId
 +Guid OrderId
}
Handler ..> Request : handles
Entry ..> Handler : dispatches
Handler --> Model : reads or changes
interface ISycapookeDbContext {
