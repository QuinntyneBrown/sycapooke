@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Class structure - Track purchases and founder sales
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class "OrdersController" as Entry {
}
class "ListOrdersQueryHandler" as Handler {
 +Handle(request: ListOrdersQuery, cancellationToken: CancellationToken): Task<OrderListDto>
}
class "OrderRowDto" as Model {
 +Guid Id
 +string Status
 +string Total
 +DateTime PaidAt
}
class "ListOrdersQuery" as Request {
 +Guid MemberId
 +OrderRole Role
}
Handler ..> Request : handles
Entry ..> Handler : dispatches
Handler --> Model : reads or changes
interface ISycapookeDbContext {
 +SaveChangesAsync(): Task<int>
}
Handler ..> ISycapookeDbContext : persistence boundary
interface IFounderAccess {
 +IsFounderAsync(memberId: Guid): Task<bool>
}
Handler ..> IFounderAccess : protected shop actions
note bottom of Handler
Operation names summarize target responsibilities.
Description distinguishes existing and proposed types.
end note
@enduml
