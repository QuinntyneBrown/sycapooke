@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Behaviour - Founder responds to the customer
autonumber
actor "Founder" as actor
box "Frontend - Sycapooke Web" #E0F2FE
 participant "ProblemDetailPage" as page
 participant "ProblemsApi" as client
end box
box "Backend - Sycapooke API" #D1FADF
 participant "OrderProblemsController" as entry
end box
box "Backend - Sycapooke Application and Domain" #ECFDF3
 participant "RespondToProblemCommandHandler" as handler
 participant "OrderProblem" as model
end box
box "Backend - Sycapooke Infrastructure" #FFF4E5
 database "Feature state / unit of work" as db
end box
participant "Payment provider" as provider
actor -> page : Founder responds to the customer
page -> client : POST /api/orders/{id}/problem/response
client -> entry : Typed HTTPS request
entry -> handler : Authenticate session or signed callback
handler -> db : Load authorized current state
db --> handler : Current state
alt Access, validation or state check refuses the action
 handler -> handler : Preserve state and return domain refusal
else Authorized and valid action
handler -> handler : Require founder [L2-010]
handler -> model : Save response on the order problem
handler -> handler : Expose thread only to founder and that customer
handler -> db : Commit valid state and outbox atomically
db --> handler : Result
end
handler --> entry : Result or domain refusal
entry --> client : Typed result or ProblemDetails
client --> page : Update feature state
page --> actor : Private response; customer resolution or reply attempt receives 403
note over entry, handler
Private response; customer resolution or reply attempt receives 403
end note
@enduml
