@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Class structure - Resolve customer order problems
skinparam class {
 BorderColor #344054
 FontColor #101828
 BackgroundColor #F9FAFB
}
class "ShopProblemsController" as Entry {
}
class "ResolveProblemCommandHandler" as Handler {
 +Handle(request: ResolveProblemCommand, cancellationToken: CancellationToken): Task<Result<ProblemDetailDto>>
}
class "OrderProblem" as Model {
 +Guid OrderId
 +ProblemStatus Status
 +string? ResolutionReason
}
class "ResolveProblemCommand" as Request {
 +Guid AdministratorId
 +string Reference
 +string? Outcome
 +string? Reason
}
Handler ..> Request : handles
Entry ..> Handler : dispatches
Handler --> Model : reads or changes
interface ISycapookeDbContext {
 +SaveChangesAsync(): Task<int>
}
Handler ..> ISycapookeDbContext : persistence boundary
interface IFounderAccess {
 +IsFounderAsync(memberId: Guid): Task<bool>
}
Handler ..> IFounderAccess : protected shop actions
note bottom of Handler
Operation names summarize target responsibilities.
Description distinguishes existing and proposed types.
end note
@enduml
